# SmartHotel.Web: nginx server for the Angular SPA.
# Rendered at container start by the nginx image from
# /etc/nginx/templates/default.conf.template to /etc/nginx/conf.d/default.conf.
# Only defined environment variables are substituted:
#   API_BASE_URL     becomes "apiBaseUrl" in /config.json
#   WEB_ENVIRONMENT  becomes "environment" in /config.json
# An undefined one is served as an empty string (see /config.json below).
# nginx variables are written without braces and stay untouched.
# Static files only: this server never proxies the API.
server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Runtime configuration fetched by the SPA before bootstrap.
  location = /config.json {
    # envsubst leaves an undefined input as its literal placeholder, which nginx
    # reads as the same-named nginx variable (names are case-insensitive) and
    # would refuse to start on. These declarations render such an input as "",
    # so the SPA shows its boot-error state for a missing API base URL and runs
    # in strict mode for a missing environment; no default value is supplied.
    # Keep them lower-case: envsubst matches names case-sensitively, so it never
    # rewrites them.
    set $api_base_url "";
    set $web_environment "";
    default_type application/json;
    add_header Cache-Control "no-store" always;
    return 200 '{"apiBaseUrl":"${API_BASE_URL}","environment":"${WEB_ENVIRONMENT}"}';
  }

  # SPA fallback so deep links load index.html.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
